\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{orgtex-cover-simple}[2026/10/13 v0.1.0 OrgTeX simple cover]

% ----------------------------------------------------------
% Simple title-page cover
% ----------------------------------------------------------

\makeatletter

\newcommand{\orgtexcoverdisablepageanchors}{%
  \@ifpackageloaded{hyperref}{%
    \hypersetup{pageanchor=false}%
  }{}%
}

\newcommand{\orgtexcoverenablepageanchors}{%
  \@ifpackageloaded{hyperref}{%
    \hypersetup{pageanchor=true}%
  }{}%
}

\newcommand{\orgtexsimplecover}{%
  \orgtexcoverdisablepageanchors

  \begin{titlepage}
    \centering
    \vspace*{\fill}

    {\LARGE\bfseries \@title \par}

    \vspace{1.5cm}

    {\large \@author \par}

    \vspace{1cm}

    {\large \@date \par}

    \vspace*{\fill}
  \end{titlepage}

  \orgtexcoverenablepageanchors
}

% Org Mode already generates \maketitle.
% Replace its standard behavior with the selected OrgTeX cover instead of
% creating an additional title page independently.
\renewcommand{\maketitle}{\orgtexsimplecover}

\makeatother

\endinput
